        { "id": "c_math_009_c", "label": "C", "text_en": "22", "is_correct": false },
        { "id": "c_math_009_d", "label": "D", "text_en": "19", "is_correct": false }
      ],
      "explanation": {
        "solution_text_en": "a_n = a_1 + (n - 1)d. 127 = 7 + (n - 1)*6 => 120 = 6(n - 1) => 20 = n - 1 => n = 21.",
