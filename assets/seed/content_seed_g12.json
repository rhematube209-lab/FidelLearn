  "questions": [
    {
      "id": "q_math_001",
      "grade": 12,
      "stream": "natural",
      "subject_id": "math_g12",
      "unit_id": "math_u1",
      "topic_id": "math_t1_1",
      "exam_year": 2023,
      "question_text_en": "What is the 20th term of the arithmetic progression 3, 7, 11, 15, ...?",
      "question_text_am": "የአርቲሜቲክ ተከታታይ 3፣ 7፣ 11፣ 15፣ ... 20ኛው ቁጥር ስንት ነው?",
      "difficulty": "easy",
      "verification_status": "published",
      "source_name": "FidelLearn original demonstration content",
      "source_page": 10,
      "content_version": 1,
      "choices": [
        { "id": "c_math_001_a", "label": "A", "text_en": "76", "text_am": "76", "is_correct": false },
        { "id": "c_math_001_b", "label": "B", "text_en": "79", "text_am": "79", "is_correct": true },
        { "id": "c_math_001_c", "label": "C", "text_en": "83", "text_am": "83", "is_correct": false },
        { "id": "c_math_001_d", "label": "D", "text_en": "80", "text_am": "80", "is_correct": false }
      ],
      "explanation": {
        "solution_text_en": "The formula for the n-th term of an AP is a_n = a_1 + (n - 1)d. Here a_1 = 3 and common difference d = 7 - 3 = 4. Therefore, a_20 = 3 + (20 - 1) * 4 = 3 + 19 * 4 = 3 + 76 = 79.",
        "simpler_explanation_en": "Start at 3 and jump forward by 4 nineteen times: 3 + 76 = 79.",
        "key_concept": "Arithmetic sequence n-th term: a_n = a_1 + (n-1)d",
        "common_pitfall": "Forgetting that the multiplier is (n - 1) rather than n."
      }
    },
    {
      "id": "q_math_002",
      "grade": 12,
      "stream": "natural",
      "subject_id": "math_g12",
      "unit_id": "math_u1",
      "topic_id": "math_t1_1",
      "exam_year": 2023,
      "question_text_en": "If the sum of the first 10 terms of an arithmetic sequence is 155 and the first term is 2, what is the common difference d?",
      "difficulty": "medium",
      "verification_status": "published",
      "source_name": "FidelLearn original demonstration content",
      "source_page": 12,
      "content_version": 1,
      "choices": [
        { "id": "c_math_002_a", "label": "A", "text_en": "2.5", "is_correct": false },
        { "id": "c_math_002_b", "label": "B", "text_en": "3", "is_correct": true },
        { "id": "c_math_002_c", "label": "C", "text_en": "3.5", "is_correct": false },
        { "id": "c_math_002_d", "label": "D", "text_en": "4", "is_correct": false }
      ],
      "explanation": {
        "solution_text_en": "Sum formula: S_n = (n/2) * [2a_1 + (n-1)d]. 155 = (10/2) * [2(2) + (10-1)d] => 155 = 5 * (4 + 9d) => 31 = 4 + 9d => 27 = 9d => d = 3.",
        "simpler_explanation_en": "Divide 155 by 5 to get 31 for [2a + 9d]. Subtract 4 to get 27, then divide by 9.",
        "key_concept": "S_n = (n/2)[2a_1 + (n-1)d]",
        "common_pitfall": "Dividing sum by n instead of (n/2)."
      }
    },
    {
      "id": "q_math_003",
      "grade": 12,
      "stream": "natural",
      "subject_id": "math_g12",
      "unit_id": "math_u1",
      "topic_id": "math_t1_2",
      "exam_year": 2022,
      "question_text_en": "For what values of x does the infinite geometric series sum_{n=1}^{infty} (2x - 1)^n converge?",
      "difficulty": "hard",
      "verification_status": "published",
      "source_name": "FidelLearn original demonstration content",
      "source_page": 24,
      "content_version": 1,
      "choices": [
        { "id": "c_math_003_a", "label": "A", "text_en": "0 < x < 1", "is_correct": true },
        { "id": "c_math_003_b", "label": "B", "text_en": "-1 < x < 1", "is_correct": false },
        { "id": "c_math_003_c", "label": "C", "text_en": "-0.5 < x < 0.5", "is_correct": false },
        { "id": "c_math_003_d", "label": "D", "text_en": "0 <= x <= 1", "is_correct": false }
      ],
      "explanation": {
        "solution_text_en": "An infinite geometric series converges if and only if |r| < 1. Here r = 2x - 1. So -1 < 2x - 1 < 1. Adding 1 gives 0 < 2x < 2, dividing by 2 gives 0 < x < 1.",
        "simpler_explanation_en": "The common ratio r must strictly be between -1 and 1.",
        "key_concept": "Convergence of geometric series: |r| < 1",
        "common_pitfall": "Including equality endpoints (<=)."
      }
    },
    {
      "id": "q_math_004",
      "grade": 12,
      "stream": "natural",
      "subject_id": "math_g12",
      "unit_id": "math_u1",
      "topic_id": "math_t1_2",
      "exam_year": 2022,
      "question_text_en": "Find the sum to infinity of the geometric series: 12 + 4 + 4/3 + 4/9 + ...",
      "difficulty": "medium",
      "verification_status": "published",
      "source_name": "FidelLearn original demonstration content",
      "source_page": 27,
      "content_version": 1,
      "choices": [
        { "id": "c_math_004_a", "label": "A", "text_en": "16", "is_correct": false },
        { "id": "c_math_004_b", "label": "B", "text_en": "18", "is_correct": true },
        { "id": "c_math_004_c", "label": "C", "text_en": "20", "is_correct": false },
        { "id": "c_math_004_d", "label": "D", "text_en": "24", "is_correct": false }
      ],
      "explanation": {
        "solution_text_en": "Here a = 12 and r = 4/12 = 1/3. S_infty = a / (1 - r) = 12 / (1 - 1/3) = 12 / (2/3) = 12 * 3 / 2 = 18.",
        "simpler_explanation_en": "S_infty = 12 / (2/3) = 18.",
        "key_concept": "S_infty = a / (1 - r) for |r| < 1",
        "common_pitfall": "Dividing by (1 + r) instead of (1 - r)."
      }
    },
    {
      "id": "q_math_005",
