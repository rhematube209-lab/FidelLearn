# FidelLearn Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing actual values to source control.
# .env* is already gitignored in this project.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL (from: Supabase Dashboard → Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable (public/anon) key — safe for client-side use.
# This is NOT the service role key.
# (from: Supabase Dashboard → Settings → API → Project API keys → anon/public)
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# ── Application ───────────────────────────────────────────────────────────────
# deployment environment: development | staging | production
# development: missing credentials → offline/mock mode (safe fallback)
# staging/production: missing credentials → app crashes at startup (fail closed)
APP_ENVIRONMENT=development

# ── Usage ─────────────────────────────────────────────────────────────────────
# flutter run -d windows ^
#   --dart-define=SUPABASE_URL=%SUPABASE_URL% ^
#   --dart-define=SUPABASE_PUBLISHABLE_KEY=%SUPABASE_PUBLISHABLE_KEY% ^
#   --dart-define=APP_ENVIRONMENT=%APP_ENVIRONMENT%
